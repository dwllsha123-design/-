NODE_ENV=production
PORT=3000
APP_NAME=دار الأنوثة
APP_URL=https://YOUR-DOMAIN.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_CURRENCY=LYD
APP_CURRENCY_SYMBOL=د.ل
APP_TIMEZONE=Africa/Tripoli

# SQLite on the server (ملف دائم — خذ نسخة احتياطية يومياً)
DATABASE_URL=file:/data/app.db

# غيّر هذه القيمة إلى نص عشوائي طويل (32 حرفاً فأكثر)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# نطاقات الواجهات فقط (بدون localhost)
CORS_ORIGINS=https://YOUR-DOMAIN.com
STORE_URL=https://YOUR-DOMAIN.com

ACCURATESS_ENABLED=false
ACCURATESS_ENDPOINT=https://mayar.lg.accuratess.com:8443/graphql
ACCURATESS_TOKEN=

# أول تشغيل فقط لإنشاء حساب المدير ثم احذف السطر أو اجعلها false
ALLOW_SEED=true
