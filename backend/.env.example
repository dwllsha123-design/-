# Development defaults. For production copy deploy/.env.production.example
NODE_ENV=development
PORT=3000
APP_NAME=دار الأنوثة
APP_URL=http://localhost:3000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_CURRENCY=LYD
APP_CURRENCY_SYMBOL=د.ل
APP_TIMEZONE=Africa/Tripoli

# Local/dev (SQLite). For production use PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dar_alunotha?schema=public"
DATABASE_URL="file:./dev.db"

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174
STORE_URL=http://localhost:5174

# Mobile apps (Android / iOS) — تُستخدم عند بناء التطبيق
MOBILE_ANDROID_PACKAGE=ly.daronotha.store
MOBILE_IOS_BUNDLE_ID=ly.daronotha.store
MOBILE_IOS_TEAM_ID=
MOBILE_DEEP_LINK_SCHEME=daronotha
MOBILE_UNIVERSAL_LINK_HOST=dar-alunotha.ly

# Push notifications (فعّل عند تجهيز Firebase / APNs)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=ly.daronotha.store

# Accuratess GraphQL shipping (Mayar) — التوكن العام كاحتياطي
# لكل صفحة فرعية (لافينا وغيرها) عيّني مفتاحها من لوحة الصفحات
# فعّل بعد وضع التوكن: ACCURATESS_ENABLED=true
ACCURATESS_ENABLED=true
ACCURATESS_ENDPOINT=https://mayar.lg.accuratess.com:8443/graphql
ACCURATESS_TOKEN=
ACCURATESS_SENDER_ZONE_ID=
ACCURATESS_SENDER_SUBZONE_ID=
ACCURATESS_DEFAULT_RECIPIENT_ZONE_ID=
ACCURATESS_DEFAULT_RECIPIENT_SUBZONE_ID=
